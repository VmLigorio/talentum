# Usa defaults de desenvolvimento; as validações adicionais só são ativadas em produção.
ENVIRONMENT=development
# Banco local exposto pelo Compose na porta 5433 do host.
DATABASE_URL=postgresql+psycopg://talentum_user:talentum_dev_password@localhost:5433/talentum
# Segredo e prazos positivos de validade dos tokens de autenticação.
JWT_SECRET=change-me-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Origem do Advisor local e provedores de dados de mercado.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
BRAPI_BASE_URL=https://brapi.dev
# Opcional: use um token Brapi para ampliar a cobertura da B3 e os limites de consulta.
BRAPI_TOKEN=
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
MARKET_DATA_TIMEOUT_SECONDS=8
MARKET_RETRY_ATTEMPTS=1
MARKET_CACHE_TTL_SECONDS=60
MARKET_ALERT_CHECK_INTERVAL_SECONDS=300
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=3600
# Limites de autenticação, requisição, hosts HTTP e documentação.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MAX_REQUEST_BODY_BYTES=12582912
TRUSTED_HOSTS=127.0.0.1,localhost
API_DOCS_ENABLED=true
REDIS_URL=
REDIS_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
