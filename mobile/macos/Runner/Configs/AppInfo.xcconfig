// Configurações do aplicativo para o destino de compilação Runner.
//
// No futuro, estas definições podem ser geradas a partir de metadados como pubspec.yaml.
// Se forem removidas, o modelo padrão do Flutter usa o nome do projeto.

// Nome do aplicativo, usado também como título padrão da janela Flutter.
PRODUCT_NAME = talentum_mobile

// Identificador exclusivo do pacote do aplicativo no macOS.
PRODUCT_BUNDLE_IDENTIFIER = com.example.talentumMobile

// Aviso de direitos autorais exibido nas informações do aplicativo.
PRODUCT_COPYRIGHT = Copyright © 2026 com.example. All rights reserved.
