<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permite ao cliente Flutter acessar a API e baixar documentos e relatórios. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- A permissão biométrica é fornecida pelo manifesto Android do plugin local_auth_android durante o merge do Gradle. -->
    <!-- Builds de produção devem apontar para uma API HTTPS; a exceção HTTP fica no manifesto debug. -->
    <application
        android:label="Talentum"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Hospeda a interface Flutter e permite que o embedding trate mudanças de configuração. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Aplica o tema nativo durante a inicialização do Flutter e define o fundo da janela após a primeira tela. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Registra a tela inicial do aplicativo para o launcher do Android. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- O Flutter usa esta informação para registrar os plugins nativos no embedding v2. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Declara a consulta de intents de texto usada pelo ProcessTextPlugin do Flutter no Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
