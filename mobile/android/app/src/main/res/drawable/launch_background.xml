<?xml version="1.0" encoding="utf-8"?>
<!-- Composição da tela nativa exibida antes da primeira renderização Flutter. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Preenche a tela com a cor institucional para evitar flashes claros. -->
    <item android:drawable="@color/talentum_background" />

    <!-- Centraliza a marca sobre o fundo da tela de abertura. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/talentum_splash_logo" />
    </item>
</layer-list>
